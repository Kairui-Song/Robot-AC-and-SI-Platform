<?xml version="1.0"?>
<!-- Schematic only: dimensions, axes and limits are NOT measured Linglong geometry. -->
<robot name="linglong_arm_demo">
  <material name="blue"><color rgba="0.15 0.5 0.85 1"/></material>
  <material name="gray"><color rgba="0.5 0.5 0.5 1"/></material>
  <link name="base_link">
    <visual><geometry><box size="0.2 0.2 0.05"/></geometry><material name="gray"/></visual>
  </link>
  <link name="link_1">
    <visual><origin xyz="0 0 0.1"/><geometry><cylinder radius="0.04" length="0.2"/></geometry><material name="blue"/></visual>
  </link>
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/><child link="link_1"/><origin xyz="0 0 0.025"/>
    <axis xyz="0 0 1"/><limit lower="-1.57" upper="1.57" effort="1" velocity="0.1"/>
  </joint>
  <link name="link_2">
    <visual><origin xyz="0 0 0.12"/><geometry><box size="0.05 0.05 0.24"/></geometry><material name="blue"/></visual>
  </link>
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/><child link="link_2"/><origin xyz="0 0 0.2"/>
    <axis xyz="0 1 0"/><limit lower="-1.57" upper="1.57" effort="1" velocity="0.1"/>
  </joint>
  <link name="link_3">
    <visual><origin xyz="0 0 0.1"/><geometry><box size="0.045 0.045 0.2"/></geometry><material name="blue"/></visual>
  </link>
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/><child link="link_3"/><origin xyz="0 0 0.24"/>
    <axis xyz="0 1 0"/><limit lower="-1.57" upper="1.57" effort="1" velocity="0.1"/>
  </joint>
  <link name="link_5">
    <visual><origin xyz="0 0 0.05"/><geometry><box size="0.06 0.04 0.1"/></geometry><material name="gray"/></visual>
  </link>
  <joint name="joint_5" type="revolute">
    <parent link="link_3"/><child link="link_5"/><origin xyz="0 0 0.2"/>
    <axis xyz="1 0 0"/><limit lower="-1.57" upper="1.57" effort="1" velocity="0.1"/>
  </joint>
</robot>
