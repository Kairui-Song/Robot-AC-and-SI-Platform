#!/usr/bin/env python3
# -*- coding: utf-8 -*-

from pathlib import Path
import importlib.util
import sys


class MotorController:
    """通过 USB 串口与主控通信的电机控制器。"""

    def __init__(self, port=None, baudrate=115200):
        self.port = port
        self.baudrate = baudrate
        self.motor_ids = {
            'head_pitch': 1,
            'head_yaw': 2,
            'head_roll': 3,
            'left_arm_0': 11,
            'left_arm_1': 12,
            'left_arm_2': 13,
            'left_arm_3': 14,
            'left_arm_4': 15,
            'left_arm_5': 16,
            'left_arm_6': 17,
            'right_arm_0': 21,
            'right_arm_1': 22,
            'right_arm_2': 23,
            'right_arm_3': 24,
            'right_arm_4': 25,
            'right_arm_5': 26,
            'right_arm_6': 27,
            'left_leg_0': 31,
            'left_leg_1': 32,
            'left_leg_2': 33,
            'left_leg_3': 34,
            'left_leg_4': 35,
            'left_leg_5': 36,
            'right_leg_0': 41,
            'right_leg_1': 42,
            'right_leg_2': 43,
            'right_leg_3': 44,
            'right_leg_4': 45,
            'right_leg_5': 46,
        }
        self._serial = None
        self._load_serial_backend()

    def _load_serial_backend(self):
        current_dir = Path(__file__).resolve().parent
        serial_path = current_dir / 'serial_comm.py'
        spec = importlib.util.spec_from_file_location('serial_comm_test', serial_path)
        module = importlib.util.module_from_spec(spec)
        sys.modules[spec.name] = module
        spec.loader.exec_module(module)
        self._serial_backend = module
        self._serial = module.SerialController(self.port, self.baudrate)

    def connect(self):
        return self._serial.connect()

    def close(self):
        self._serial.close()

    def _send(self, motor_ids, positions):
        cmd = self._serial_backend.pack_multi_motor_command(motor_ids, positions)
        return self._serial.send(cmd)

    def set_head(self, pitch, yaw, roll):
        ids = [self.motor_ids['head_pitch'], self.motor_ids['head_yaw'], self.motor_ids['head_roll']]
        return self._send(ids, [pitch, yaw, roll])

    def set_left_arm(self, angles):
        if len(angles) != 7:
            raise ValueError('left arm needs 7 angles')
        ids = [self.motor_ids[f'left_arm_{i}'] for i in range(7)]
        return self._send(ids, angles)

    def set_right_arm(self, angles):
        if len(angles) != 7:
            raise ValueError('right arm needs 7 angles')
        ids = [self.motor_ids[f'right_arm_{i}'] for i in range(7)]
        return self._send(ids, angles)

    def set_left_leg(self, angles):
        if len(angles) != 6:
            raise ValueError('left leg needs 6 angles')
        ids = [self.motor_ids[f'left_leg_{i}'] for i in range(6)]
        return self._send(ids, angles)

    def set_right_leg(self, angles):
        if len(angles) != 6:
            raise ValueError('right leg needs 6 angles')
        ids = [self.motor_ids[f'right_leg_{i}'] for i in range(6)]
        return self._send(ids, angles)
